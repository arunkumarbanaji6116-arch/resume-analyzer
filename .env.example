SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=true
GEMINI_API_KEY=your-gemini-api-key-here

# Resend.com Configuration (Recommended for instant mail delivery)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CareerForge.AI <onboarding@resend.dev>

# Standard SMTP Configuration (Alternative / Fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CareerForge.AI
# Supabase Configuration
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_PUBLIC_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
